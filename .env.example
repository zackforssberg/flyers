# Supabase project URL (dev or prod)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable/anon key. Safe to expose; read-only via RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret/service role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Password for the admin login.
ADMIN_PASSWORD=

# Secret URL segment for the admin page, e.g. "x7k2-flyers" -> /x7k2-flyers
ADMIN_PATH_SECRET=
